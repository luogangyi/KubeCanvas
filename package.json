{
  "name": "kubecanvas",
  "version": "1.0.0",
  "description": "Visual Kubernetes Resource Orchestration Tool - Design and manage K8s resources through drag-and-drop",
  "author": "KubeCanvas Authors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/KubeCanvas.git"
  },
  "keywords": [
    "kubernetes",
    "k8s",
    "visual",
    "orchestration",
    "drag-and-drop",
    "vue",
    "canvas"
  ],
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "download-schemas": "npx tsx scripts/download-schemas.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.1",
    "axios": "^1.13.2",
    "uuid": "^13.0.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  }
}