# K8s API 配置环境变量
# 复制此文件为 .env.local 并填写真实配置
# .env.local 不会被提交到 Git

# 运行模式: 'in-cluster' | 'custom'
VITE_K8S_MODE=custom

# K8s API Server 地址
# 可通过 kubectl cluster-info 获取
VITE_K8S_API_SERVER=https://your-k8s-api-server:6443

# 认证 Token
# 获取方式: kubectl create token <service-account> -n <namespace> --duration=8760h
VITE_K8S_TOKEN=your-bearer-token-here

# 默认命名空间
VITE_K8S_NAMESPACE=default

# 请求超时时间（毫秒）
VITE_K8S_TIMEOUT=30000

# 是否跳过 TLS 证书验证（仅开发环境使用）
VITE_K8S_SKIP_TLS=true

# ==================================
# 日志配置
# ==================================

# 日志级别: debug | info | warn | error
VITE_LOG_LEVEL=info

# 是否输出到控制台
VITE_LOG_CONSOLE=true

# 是否持久化到远程 (需要配置 VITE_LOG_ENDPOINT)
VITE_LOG_PERSIST=false

# 日志收集端点 (可选，如 Loki)
VITE_LOG_ENDPOINT=

# ==================================
# UI 配置
# ==================================

# 主题: dark | light (默认 dark)
VITE_UI_THEME=dark


