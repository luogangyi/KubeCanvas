// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ConfigMap Generator > Snapshot Testing > should match snapshot for full ConfigMap > nginx-configmap 1`] = `
"apiVersion: v1
kind: ConfigMap
metadata:
  name: nginx-config
  namespace: web
