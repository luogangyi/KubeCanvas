// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PVC Generator > Snapshot Testing > should match snapshot for production PVC > postgres-pvc 1`] = `
"apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-data
  namespace: database
  labels:
    app: postgres
    tier: database
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 100Gi
  storageClassName: premium-ssd
  volumeMode: Filesystem
"
